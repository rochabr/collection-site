---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugify } from '../../lib/slugify';

export async function getStaticPaths() {
  const artists = await getCollection('artists');
  const works = await getCollection('works');
  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: {
      artist,
      works: works
        .filter((w) => slugify(w.data.artist) === artist.id)
        .sort((a, b) => (a.data.year ?? '').localeCompare(b.data.year ?? '')),
    },
  }));
}

const { artist, works } = Astro.props;
const { Content } = await render(artist);

const dates = [artist.data.born, artist.data.died].filter(Boolean).join(' – ');
const meta = [artist.data.nationality, artist.data.movement].filter(Boolean).join(' — ');

const base = import.meta.env.BASE_URL;
const join = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<Base title={artist.data.name}>
  <a class="back" href={join('artists/')}>← Artists</a>
  <header class="artist-header">
    {artist.data.portrait && (
      <img class="portrait" src={join(`images/artists/${artist.data.portrait}`)} alt={`Portrait of ${artist.data.name}`} />
    )}
    <div class="artist-meta">
      <h2>{artist.data.name}</h2>
      {dates && <div class="dates">{dates}</div>}
      {meta && <div class="meta">{meta}</div>}
      {artist.data.portrait_credit && (
        <div class="portrait-credit">{artist.data.portrait_credit}</div>
      )}
    </div>
  </header>

  <div class="bio">
    <Content />
  </div>

  {artist.data.sources && artist.data.sources.length > 0 && (
    <section class="sources">
      <h3>Sources</h3>
      <ol>
        {artist.data.sources.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>
        ))}
      </ol>
    </section>
  )}

  {works.length > 0 && (
    <section class="works-section">
      <h3>In the collection</h3>
      <div class="grid">
        {works.map((work) => {
          const thumb = work.data.images?.[0];
          return (
            <a class="card" href={join(`works/${work.id}/`)}>
              <div class="thumb">
                {thumb
                  ? <img src={join(thumb)} alt={`${work.data.artist} — ${work.data.title}`} loading="lazy" />
                  : <span>No image</span>}
              </div>
              <div class="title">{work.data.title}{work.data.year ? `, ${work.data.year}` : ''}</div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</Base>
