---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugify } from '../../lib/slugify';

const artists = await getCollection('artists');
const works = await getCollection('works');

const worksByArtist = new Map<string, number>();
for (const w of works) {
  const key = slugify(w.data.artist);
  worksByArtist.set(key, (worksByArtist.get(key) ?? 0) + 1);
}

const sorted = artists.sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'pt-BR')
);

const base = import.meta.env.BASE_URL;
const join = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<Base title="Artists">
  <ul class="artist-list">
    {sorted.map((artist) => {
      const count = worksByArtist.get(artist.id) ?? 0;
      const dates = [artist.data.born, artist.data.died].filter(Boolean).join(' – ');
      return (
        <li>
          <a href={join(`artists/${artist.id}/`)}>
            {artist.data.portrait
              ? <img class="thumb-mini" src={join(`images/artists/${artist.data.portrait}`)} alt="" loading="lazy" />
              : <span class="thumb-mini placeholder" aria-hidden="true">{artist.data.name.split(' ').map(w => w[0]).join('').slice(0, 2)}</span>}
            <span class="name">{artist.data.name}</span>
            {dates && <span class="dates"> ({dates})</span>}
            <span class="count">{count} {count === 1 ? 'work' : 'works'}</span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>
