---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugify } from '../../lib/slugify';

const artists = await getCollection('artists');
const works = await getCollection('works');

const worksByArtist = new Map<string, number>();
for (const w of works) {
  const key = slugify(w.data.artist);
  worksByArtist.set(key, (worksByArtist.get(key) ?? 0) + 1);
}

const sorted = artists.sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'pt-BR')
);

const base = import.meta.env.BASE_URL;
const join = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const initials = (name: string) =>
  name.split(' ').filter(Boolean).map(w => w[0]).join('').slice(0, 2);
---
<Base title="Artists">
  <div class="grid">
    {sorted.map((artist) => {
      const count = worksByArtist.get(artist.id) ?? 0;
      const dates = [artist.data.born, artist.data.died].filter(Boolean).join(' – ');
      return (
        <a class="card" href={join(`artists/${artist.id}/`)}>
          <div class="thumb">
            {artist.data.portrait
              ? <img src={join(`images/artists/${artist.data.portrait}`)} alt={`Portrait of ${artist.data.name}`} loading="lazy" />
              : <span class="initials">{initials(artist.data.name)}</span>}
          </div>
          <div class="artist">{artist.data.name}</div>
          {dates && <div class="title">{dates}</div>}
          <div class="count">{count} {count === 1 ? 'work' : 'works'}</div>
        </a>
      );
    })}
  </div>
</Base>
