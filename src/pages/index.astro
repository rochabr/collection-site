---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const works = (await getCollection('works')).sort((a, b) =>
  a.data.artist.localeCompare(b.data.artist, 'pt-BR')
);

const base = import.meta.env.BASE_URL;
const join = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<Base title="Collection">
  <div class="grid">
    {works.map((work) => {
      const thumb = work.data.images?.[0];
      return (
        <a class="card" href={join(`works/${work.id}/`)}>
          <div class="thumb">
            {thumb
              ? <img src={join(thumb)} alt={`${work.data.artist} — ${work.data.title}`} loading="lazy" />
              : <span>No image</span>}
          </div>
          <div class="artist">{work.data.artist}</div>
          <div class="title">{work.data.title}{work.data.year ? `, ${work.data.year}` : ''}</div>
        </a>
      );
    })}
  </div>
</Base>
