---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const works = (await getCollection('works')).sort((a, b) =>
  a.data.artist.localeCompare(b.data.artist)
);

const base = import.meta.env.BASE_URL;
const join = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<Base title="Collection">
  <div class="grid">
    {works.map((work) => (
      <a class="card" href={join(`works/${work.id}/`)}>
        <div class="thumb">
          {work.data.image
            ? <img src={join(work.data.image)} alt={`${work.data.artist} — ${work.data.title}`} />
            : <span>No image</span>}
        </div>
        <div class="artist">{work.data.artist}</div>
        <div class="title">{work.data.title}{work.data.year ? `, ${work.data.year}` : ''}</div>
      </a>
    ))}
  </div>
</Base>
