---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../lib/i18n';

const locale: Locale = 'en';
const s = t(locale);

const works = (await getCollection('works')).sort((a, b) =>
  a.data.artist.localeCompare(b.data.artist, 'pt-BR')
);

const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
const localeBase = `${normalizedBase}/en`;
const join = (path: string) => `${localeBase}/${path.replace(/^\//, '')}`;
const asset = (path: string) => `${normalizedBase}/${path.replace(/^\//, '')}`;
---
<Base title="Acervo Rocha">
  <div class="grid">
    {works.map((work) => {
      const thumb = work.data.images?.[0];
      return (
        <a class="card" href={join(`works/${work.id}/`)}>
          <div class="thumb">
            {thumb
              ? <img src={asset(thumb)} alt={`${work.data.artist} — ${work.data.title}`} loading="lazy" />
              : <span>{s.no_image}</span>}
          </div>
          <div class="artist">{work.data.artist}</div>
          <div class="title">{work.data.title}{work.data.year ? `, ${work.data.year}` : ''}</div>
        </a>
      );
    })}
  </div>
</Base>
