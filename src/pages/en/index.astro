---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugify } from '../../lib/slugify';
import { t, type Locale } from '../../lib/i18n';
import { CHAPTERS, groupForArtist } from '../../lib/chapters';

const locale: Locale = 'en';
const s = t(locale);

const works = (await getCollection('works')).sort((a, b) =>
  a.data.artist.localeCompare(b.data.artist, 'pt-BR')
);

const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
const localeBase = `${normalizedBase}/en`;
const join = (path: string) => `${localeBase}/${path.replace(/^\//, '')}`;
const asset = (path: string) => `${normalizedBase}/${path.replace(/^\//, '')}`;

const catalog = new Map(works.map((w, i) => [w.id, String(i + 1).padStart(2, '0')]));
const artistCount = new Set(works.map((w) => slugify(w.data.artist))).size;

// Featured hero piece. The pool is every work that has an image. The server
// renders a random one (chosen at build time) as the no-JS / crawler fallback;
// the small client script below re-picks on every page load so it feels random
// to visitors — necessary because this is a statically built site.
const featuredPool = works
  .filter((w) => w.data.images?.[0])
  .map((w) => ({
    href: join(`works/${w.id}/`),
    img: asset(w.data.images![0]),
    alt: `${w.data.artist} — ${w.data.title}`,
    cat: catalog.get(w.id)!,
    artist: w.data.artist,
    title: w.data.title,
  }));
const featured = featuredPool[Math.floor(Math.random() * featuredPool.length)];
const featuredJson = JSON.stringify(featuredPool).replace(/</g, '\\u003c');

const grouped = CHAPTERS.map((ch) => ({
  ch,
  items: works.filter((w) => groupForArtist(slugify(w.data.artist)) === ch.key),
})).filter((g) => g.items.length > 0);
---
<Base title="Acervo Rocha">
  <section class="home-hero">
    <div class="hero-lead">
      <div class="eyebrow">{s.eyebrow}</div>
      <h1 class="hero-head">{s.hero_head}</h1>
      <p class="hero-body">{s.hero_body}</p>
      <div class="stats">
        <div class="stat"><span class="num">{works.length}</span><span class="lbl">{s.works_label}</span></div>
        <div class="stat"><span class="num">{artistCount}</span><span class="lbl">{s.artists_label}</span></div>
      </div>
    </div>
    {featured && (
      <a class="featured" id="featured" href={featured.href}>
        <div class="featured-img">
          <img src={featured.img} alt={featured.alt} loading="lazy" />
        </div>
        <div class="featured-cap">
          <span class="cat">Nº {featured.cat}</span>
          <span class="fa">{featured.artist}</span>
          <span class="ft">{featured.title}</span>
        </div>
      </a>
    )}
    <script type="application/json" id="featured-pool" is:inline set:html={featuredJson}></script>
    <script is:inline>
      (() => {
        const data = document.getElementById('featured-pool');
        const a = document.getElementById('featured');
        if (!data || !a) return;
        let pool;
        try { pool = JSON.parse(data.textContent || '[]'); } catch (e) { return; }
        if (!Array.isArray(pool) || pool.length < 2) return;
        const pick = pool[Math.floor(Math.random() * pool.length)];
        a.setAttribute('href', pick.href);
        const img = a.querySelector('.featured-img img');
        if (img) { img.setAttribute('src', pick.img); img.setAttribute('alt', pick.alt); }
        const cat = a.querySelector('.cat'); if (cat) cat.textContent = 'Nº ' + pick.cat;
        const fa = a.querySelector('.fa'); if (fa) fa.textContent = pick.artist;
        const ft = a.querySelector('.ft'); if (ft) ft.textContent = pick.title;
      })();
    </script>
  </section>

  {grouped.map(({ ch, items }) => (
    <section class="chapter">
      <div class="chapter-head">
        <span class="roman">{ch.roman}</span>
        <h2>{ch.labels[locale]}</h2>
        <span class="blurb">{ch.blurbs[locale]}</span>
      </div>
      <div class="grid">
        {items.map((work) => {
          const thumb = work.data.images?.[0];
          return (
            <a class="card work-card" href={join(`works/${work.id}/`)}>
              <div class="thumb">
                {thumb
                  ? <img src={asset(thumb)} alt={`${work.data.artist} — ${work.data.title}`} loading="lazy" />
                  : <span>{s.no_image}</span>}
                <span class="cat">Nº {catalog.get(work.id)}</span>
              </div>
              <div class="artist">{work.data.artist}</div>
              <div class="title">{work.data.title}{work.data.year ? `, ${work.data.year}` : ''}</div>
            </a>
          );
        })}
      </div>
    </section>
  ))}
</Base>
