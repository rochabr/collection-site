---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { slugify } from '../../../lib/slugify';
import { t, acquisitionLine, type Locale } from '../../../lib/i18n';

const locale: Locale = 'en';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const s = t(locale);

const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
const localeBase = `${normalizedBase}/en`;
const join = (path: string) => `${localeBase}/${path.replace(/^\//, '')}`;
const asset = (path: string) => `${normalizedBase}/${path.replace(/^\//, '')}`;

const images = work.data.images ?? [];
const primary = images[0];

const acquisition = acquisitionLine(work.data.auction_house, work.data.auction_date, locale);
---
<Base title={`${work.data.artist} — ${work.data.title}`}>
  <a class="back" href={localeBase + '/'}>{s.back_collection}</a>
  <div class="work-page">
    <div class="image-col">
      {primary
        ? <img id="primary-image" src={asset(primary)} alt={`${work.data.artist} — ${work.data.title}`} />
        : <div class="placeholder">{s.no_image}</div>}
      {images.length > 1 && (
        <div class="extras">
          {images.map((src, i) => (
            <button type="button" class:list={["thumb-btn", { active: i === 0 }]} data-src={asset(src)} aria-label={`${i + 1} / ${images.length}`}>
              <img src={asset(src)} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>
    <div class="meta-col">
      <h2><a href={join(`artists/${slugify(work.data.artist)}/`)}>{work.data.artist}</a></h2>
      <div class="title-line">{work.data.title}{work.data.year ? `, ${work.data.year}` : ''}</div>
      <dl>
        {work.data.medium && <><dt>{s.medium}</dt><dd>{work.data.medium}</dd></>}
        {work.data.dimensions && <><dt>{s.dimensions}</dt><dd>{work.data.dimensions}</dd></>}
        {work.data.edition && <><dt>{s.edition}</dt><dd>{work.data.edition}</dd></>}
        {work.data.signature && <><dt>{s.signature}</dt><dd>{work.data.signature}</dd></>}
        {work.data.framed && <><dt>{s.framing}</dt><dd>{work.data.framed}</dd></>}
        {work.data.provenance && <><dt>{s.provenance}</dt><dd>{work.data.provenance}</dd></>}
        {work.data.catalog_reference && <><dt>{s.catalog_reference}</dt><dd>{work.data.catalog_reference}</dd></>}
        {acquisition && <><dt>{s.acquisition}</dt><dd>{acquisition}</dd></>}
      </dl>
      <div class="description">
        <Content />
      </div>
    </div>
  </div>

  {primary && (
    <dialog id="lightbox" aria-label={s.image_viewer}>
      <button type="button" id="lightbox-close" class="lightbox-close" aria-label={s.close}>×</button>
      {images.length > 1 && (
        <>
          <button type="button" id="lightbox-prev" class="lightbox-nav prev" aria-label={s.previous_image}>‹</button>
          <button type="button" id="lightbox-next" class="lightbox-nav next" aria-label={s.next_image}>›</button>
        </>
      )}
      <img id="lightbox-image" alt="" />
    </dialog>
  )}
</Base>

<script>
  const primary = document.getElementById('primary-image') as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb-btn'));
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;

  if (primary) {
    const srcs = thumbs.length > 0
      ? thumbs.map((t) => t.dataset.src ?? '')
      : [primary.src];
    let active = 0;

    const wrap = (n: number) => ((n % srcs.length) + srcs.length) % srcs.length;
    const setActive = (idx: number) => {
      active = wrap(idx);
      const src = srcs[active];
      if (src) {
        primary.src = src;
        if (lightboxImage) lightboxImage.src = src;
      }
      thumbs.forEach((t, i) => t.classList.toggle('active', i === active));
    };

    thumbs.forEach((btn, i) => btn.addEventListener('click', () => setActive(i)));

    primary.addEventListener('click', () => {
      if (lightboxImage) lightboxImage.src = srcs[active];
      lightbox?.showModal();
    });

    document.getElementById('lightbox-close')?.addEventListener('click', () => lightbox?.close());
    document.getElementById('lightbox-prev')?.addEventListener('click', () => setActive(active - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => setActive(active + 1));

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.close();
    });

    document.addEventListener('keydown', (e) => {
      if (srcs.length < 2) return;
      if (e.key === 'ArrowRight') setActive(active + 1);
      else if (e.key === 'ArrowLeft') setActive(active - 1);
    });
  }
</script>
