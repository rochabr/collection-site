---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { slugify } from '../../../lib/slugify';
import { t, type Locale } from '../../../lib/i18n';

const locale: Locale = 'en';

export async function getStaticPaths() {
  const all = await getCollection('artists');
  const artistsThisLocale = all.filter((a) => a.id.startsWith('en/'));
  const works = await getCollection('works');
  return artistsThisLocale.map((artist) => {
    const slug = artist.id.replace(/^en\//, '');
    return {
      params: { slug },
      props: {
        artist,
        works: works
          .filter((w) => slugify(w.data.artist) === slug)
          .sort((a, b) => (a.data.year ?? '').localeCompare(b.data.year ?? '')),
      },
    };
  });
}

const { artist, works } = Astro.props;
const { Content } = await render(artist);
const s = t(locale);

const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
const localeBase = `${normalizedBase}/en`;
const join = (path: string) => `${localeBase}/${path.replace(/^\//, '')}`;
const asset = (path: string) => `${normalizedBase}/${path.replace(/^\//, '')}`;

function heroSubtitle(): string | null {
  const { born, died, birthplace } = artist.data;
  if (!born && !died && !birthplace) return null;
  let datePart = '';
  if (born && died) datePart = `${born}–${died}`;
  else if (born) datePart = `${s.born_prefix} ${born}`;
  else if (died) datePart = `d. ${died}`;
  return [datePart, birthplace].filter(Boolean).join(', ');
}

const subtitle = heroSubtitle();

const heroWork = works[0];
const heroImage = heroWork?.data.images?.[0]
  ? asset(heroWork.data.images[0])
  : null;
const heroCaption = heroWork
  ? `${heroWork.data.title}${heroWork.data.year ? `, ${heroWork.data.year}` : ''}`
  : null;
---
<Base title={artist.data.name}>
  <section class="artist-hero" style={heroImage ? `background-image: url(${heroImage})` : undefined}>
    <a class="hero-back" href={join('artists/')}>{s.back_artists}</a>
    <div class="artist-hero-content">
      <h2>{artist.data.name}</h2>
      {subtitle && <div class="hero-subtitle">{subtitle}</div>}
    </div>
    {heroCaption && (
      <div class="hero-caption">{heroCaption}</div>
    )}
  </section>

  {artist.data.movement && (
    <div class="bio-meta">{artist.data.movement}</div>
  )}

  <div class="bio-layout">
    {artist.data.portrait && (
      <aside class="bio-aside">
        <img class="aside-portrait" src={asset(`images/artists/${artist.data.portrait}`)} alt={artist.data.name} />
        {artist.data.portrait_credit && (
          <div class="aside-credit">{artist.data.portrait_credit}</div>
        )}
      </aside>
    )}
    <div class="bio">
      <Content />
    </div>
  </div>

  {artist.data.sources && artist.data.sources.length > 0 && (
    <section class="sources">
      <h3>{s.sources}</h3>
      <ol>
        {artist.data.sources.map((src) => (
          <li><a href={src.url} target="_blank" rel="noopener">{src.title}</a></li>
        ))}
      </ol>
    </section>
  )}

  {works.length > 0 && (
    <section class="works-section">
      <h3>{s.in_collection}</h3>
      <div class="grid">
        {works.map((work) => {
          const thumb = work.data.images?.[0];
          return (
            <a class="card work-card" href={join(`works/${work.id}/`)}>
              <div class="thumb">
                {thumb
                  ? <img src={asset(thumb)} alt={`${work.data.artist} — ${work.data.title}`} loading="lazy" />
                  : <span>{s.no_image}</span>}
              </div>
              <div class="title">{work.data.title}{work.data.year ? `, ${work.data.year}` : ''}</div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</Base>
