---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { slugify } from '../../../lib/slugify';
import { t, workCount, type Locale } from '../../../lib/i18n';

const locale: Locale = 'en';
const s = t(locale);

const all = await getCollection('artists');
const artists = all.filter((a) => a.id.startsWith(`${locale}/`));
const works = await getCollection('works');

const worksByArtist = new Map<string, number>();
for (const w of works) {
  const key = slugify(w.data.artist);
  worksByArtist.set(key, (worksByArtist.get(key) ?? 0) + 1);
}

const sorted = artists.sort((a, b) => a.data.name.localeCompare(b.data.name, 'pt-BR'));

const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
const localeBase = `${normalizedBase}/en`;
const join = (path: string) => `${localeBase}/${path.replace(/^\//, '')}`;
const asset = (path: string) => `${normalizedBase}/${path.replace(/^\//, '')}`;
const slugOf = (id: string) => id.replace(/^[a-z]{2}\//, '');

const initials = (name: string) =>
  name.split(' ').filter(Boolean).map((w) => w[0]).join('').slice(0, 2);

const line = (a: (typeof sorted)[number]) => {
  const dates = [a.data.born, a.data.died].filter(Boolean).join(' – ');
  return [dates, a.data.movement].filter(Boolean).join(' · ');
};
---
<Base title={s.artists}>
  <div class="page-head">
    <div class="row">
      <h1>{s.artists}</h1>
      <span class="meta">{sorted.length} · {works.length} {s.works_label}</span>
    </div>
    <p class="intro">{s.artists_intro}</p>
  </div>

  <div class="artist-index">
    {sorted.map((artist) => {
      const slug = slugOf(artist.id);
      const count = worksByArtist.get(slug) ?? 0;
      return (
        <a class="artist-row" href={join(`artists/${slug}/`)}>
          <div class="ar-portrait">
            {artist.data.portrait
              ? <img src={asset(`images/artists/${artist.data.portrait}`)} alt={artist.data.name} loading="lazy" />
              : <span class="initials">{initials(artist.data.name)}</span>}
          </div>
          <div class="ar-info">
            <div class="ar-name">{artist.data.name}</div>
            <div class="ar-line">{line(artist)}</div>
          </div>
          <div class="ar-count">{workCount(count, locale)}</div>
        </a>
      );
    })}
  </div>
</Base>
