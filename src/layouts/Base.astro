---
import '../styles/global.css';

const SITE = 'Acervo Rocha';

interface Props {
  title: string;
}
const { title } = Astro.props;
const docTitle = title === SITE ? SITE : `${title} — ${SITE}`;
const base = import.meta.env.BASE_URL;
const join = (path: string) =>
  `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
  </head>
  <body>
    <header>
      <a href={base}><h1>{SITE}</h1></a>
      <nav>
        <a href={base}>Works</a>
        <a href={join('artists/')}>Artists</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
