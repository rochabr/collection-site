---
import '../styles/global.css';
import { t, DEFAULT_LOCALE, LOCALES, type Locale, localizedPath } from '../lib/i18n';

const SITE = 'Acervo Rocha';

interface Props {
  title: string;
}
const { title } = Astro.props;
const docTitle = title === SITE ? SITE : `${title} — ${SITE}`;

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const s = t(locale);

const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
const join = (path: string) => `${normalizedBase}/${path.replace(/^\//, '')}`;

const homePath = locale === DEFAULT_LOCALE ? `${normalizedBase}/` : `${normalizedBase}/${locale}/`;
const artistsPath = locale === DEFAULT_LOCALE
  ? join('artists/')
  : `${normalizedBase}/${locale}/artists/`;

const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <link rel="icon" href={join('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={join('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={join('favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={join('apple-touch-icon.png')} />
  </head>
  <body>
    <header>
      <div class="header-row">
        <div class="header-main">
          <a href={homePath} class="site-title">
            <h1>
              <img src={join('images/logo-wordmark-black.png')} alt={SITE} class="logo" />
              <span class="visually-hidden">{SITE}</span>
            </h1>
          </a>
          <nav>
            <a href={homePath}>{s.works}</a>
            <a href={artistsPath}>{s.artists}</a>
          </nav>
        </div>
        <nav class="lang-switcher">
          {LOCALES.map((loc) => (
            <a
              href={localizedPath(currentPath, loc, normalizedBase)}
              class:list={[{ active: loc === locale }]}
              hreflang={loc}
            >
              {loc.toUpperCase()}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
